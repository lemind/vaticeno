[Unit]
Description=Vaticeno X bot (mention poller)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaticeno
WorkingDirectory=/opt/vaticeno
ExecStart=/usr/bin/node --env-file=.env --import tsx src/poc/poll.ts
Restart=always
RestartSec=10
# Only one instance may ever run: two pollers double-reply and fight over the rotating refresh token.
KillSignal=SIGINT
TimeoutStopSec=15
# Exit 78 = fatal auth/config error (see src/poc/poll.ts): stay stopped instead of crash-looping.
RestartPreventExitStatus=78
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/vaticeno/.state
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
