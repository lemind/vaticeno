[Unit]
Description=Vaticeno X bot (mentions, lock, resolver, pages on localhost)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=vaticeno
WorkingDirectory=/opt/vaticeno
ExecStart=/usr/bin/node --env-file=.env --import tsx src/web/server.ts
Restart=always
RestartSec=10
# Only one instance may ever run (ENABLE_JOBS): two would double-reply and fight over the rotating refresh token.
KillSignal=SIGINT
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/vaticeno/.state
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
