# X developer app → Keys and tokens → Bearer Token (app-only, read-only is enough for the POC)
X_BEARER_TOKEN=
# Numeric ID of the bot account. Get it once with: npm run poc:whoami
X_BOT_USER_ID=
X_BOT_HANDLE=vaticeno
POLL_INTERVAL_SEC=60

# OAuth 1.0a user context (for posting replies later)
X_API_KEY=
X_API_KEY_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# OAuth 2.0 user context for posting (npm run poc:auth once, signed in as the bot)
X_OAUTH2_CLIENT_ID=
X_OAUTH2_CLIENT_SECRET=
X_OAUTH2_REDIRECT_URI=http://localhost:3033/callback
# Replies go ONLY to these author IDs (comma-separated). '*' = anyone. Empty = replies off.
REPLY_ALLOWLIST_USER_IDS=
# Self-imposed reply caps (INIT_SPEC §6.1)
REPLY_MAX_PER_AUTHOR_PER_HOUR=3
REPLY_MAX_PER_DAY=300

# ── Stage 0 core ──────────────────────────────────────────────
# Postgres. Local: compose.yaml. Production: Supabase session pooler string.
DATABASE_URL=postgres://postgres:dev@localhost:5433/vaticeno
# The status page's read-only role: SELECT on the tables it shows, nothing else (003 FR-003). On the
# server this lives in its own file, `.env.status`, not here — the page holds no other credential.
# Created by the migrations without a login; the password is set by hand (deploy/status-role.md).
DATABASE_URL_RO=postgres://status_ro:dev@localhost:5433/vaticeno
# replay = recorded responses only, no network, no cost (default; CI uses this)
# record = live calls, saved to fixtures/replay/ · live = live calls, nothing saved
LLM_MODE=replay
# Needed only for LLM_MODE=live|record
GEMINI_API_KEY=
# Model IDs (part of every replay key). Empty = the default tier chosen by the corpus / seeds runs
# NORMALIZER_MODEL default: gemini-3.1-flash-lite (T035: 100/100 on the corpus, cheapest available)
NORMALIZER_MODEL=
JUDGE_MODEL_A=
JUDGE_MODEL_B=
ARBITER_MODEL=
# ANSWER_MODEL default: gemini-3.8-flash. Only the replies written to people run on it — holding a short
# conversation is a different job from parsing a prediction, and the lite model showed it (2026-10-11).
ANSWER_MODEL=
# Errors, logs, cron monitors (research R11). Empty = Sentry off.
SENTRY_DSN=
# Sentry reports only when NODE_ENV=production (the droplet .env); local runs never do.
NODE_ENV=
PORT=3000
# true on exactly one server: runs lock (every minute), needs-info expiry (10 min) and resolver (hourly)
ENABLE_JOBS=false
# true (with ENABLE_JOBS): read mentions on X, record claims, post replies — needs the X_* variables above
ENABLE_X=false

# ── Own-feed content (spec 002) ────────────────────────────────
# true (with ENABLE_JOBS): run the content jobs — pool reposts (2×/day), the daily original, receipts
ENABLE_FEED=false
# true (default): picks are only logged. false posts them for real — switch after the dry run
FEED_DRY_RUN=true
# Numeric ID of the pool account kept outside the repo. Empty = skipped
FEED_PLATFORM_ACCOUNT_ID=
# The feed stops for the day when its recorded costs reach this (USD)
FEED_DAILY_USD_CAP=0.15

# ── Settlement on a testnet (spec 003 Stage 2, docs/decisions/002-escrow-v1.md) ──
# Base Sepolia only (chain id 84532). No key here: the deployer signs from Foundry's keystore.
BASE_SEPOLIA_RPC_URL=
ESCROW_CHAIN_ID=84532
# Printed by contracts/script/Deploy.s.sol after T330
ESCROW_ADDRESS=
STAKE_TOKEN_ADDRESS=
# Public addresses only. The oracle signs settlements; the guardian is a separate key held offline
ORACLE_ADDRESS=
GUARDIAN_ADDRESS=
FEE_RECIPIENT_ADDRESS=
# The settlement worker reads its own file, /etc/vaticeno-settle/env (deploy/vaticeno-settle.service), never this
# one: DATABASE_URL_SETTLE (the settle_rw role), ORACLE_KEY_FILE (a mode-600 file holding the oracle key), and
# BASE_SEPOLIA_RPC_URL, ESCROW_ADDRESS, ESCROW_CHAIN_ID as above.
